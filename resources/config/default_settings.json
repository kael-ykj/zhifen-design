{
    "version": "3.1.0",
    "ui": {
        "theme": "dark",
        "language": "zh_CN",
        "canvasColor": "#000000",
        "crosshairColor": "#969696",
        "showGrid": true,
        "gridColor": "#333333",
        "gridSpacing": 1000
    },
    "drawing": {
        "units": "mm",
        "precision": 2,
        "defaultLineWidth": 0.25,
        "defaultTextHeight": 300,
        "snapEnabled": true,
        "snapSpacing": 100,
        "orthoEnabled": false,
        "polarEnabled": true
    },
    "indoor": {
        "defaultFrequency": "5G",
        "feederLossPer100m": 3.5,
        "antennaPowerMin": -15,
        "antennaPowerMax": 15,
        "autoLinkCalc": true
    },
    "export": {
        "defaultScale": 100,
        "paperSize": "A3",
        "defaultFormat": "PDF"
    }
}
