{
  "name": "zhifen-design",
  "version": "3.1.0",
  "description": "智分Design - AI驱动的专业室分设计CAD软件",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "tsc --watch",
    "pack": "npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "author": "智分Design",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  },
  "build": {
    "appId": "com.zhifen.design",
    "productName": "智分Design",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智分Design V3.1"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ]
  }
}
